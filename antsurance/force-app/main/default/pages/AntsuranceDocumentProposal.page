<apex:page controller="AntsuranceDocumentProposalController" renderAs="{!IF($CurrentPage.parameters.preview == '1', null, 'pdf')}" applyHtmlTag="false" applyBodyTag="false" showHeader="false"
    sidebar="false" standardStylesheets="false" docType="html-5.0" readOnly="true">
<!--
    Antsurance quote proposal for a policy sale, printed as a US Letter PDF:
    /apex/AntsuranceDocumentProposal?id=<Opportunity Id> (add &download=1 to save it instead of viewing it).

    The first page is the offer: up to three quoted options as columns, then what happens next. The second
    page lists what the customer told us, from the answers stored on the recommended quote. The options
    are printed row by row, each row repeating over the options, so the columns line up whatever they say.
    The shared print styles are in the antsuranceDocumentStyles static resource.
-->
<html class="{!IF($CurrentPage.parameters.preview == '1', 'preview', 'print')}">
<head>
<apex:stylesheet value="{!$Resource.antsuranceDocumentStyles}"/>
<style type="text/css">
    .intro { margin-top: 12pt; }
    .intro div { white-space: nowrap; }

    /* The options. Each is a column of cells with a rule on top; the recommended one is tinted. */
    .options { margin-top: 8pt; }
    .options td.gap { padding: 0; }
    .options td.option { padding: 0 12pt 0 12pt; white-space: nowrap; }
    .options td.lead-option { background-color: #f0eee7; }
    .options .top td.option { padding-top: 10pt; border-top: 3pt solid #b0aea5; }
    .options .top td.lead-option { border-top-color: #d97757; }
    .options .bottom td.option { padding-bottom: 12pt; }
    .tag { font-size: 6.5pt; font-weight: bold; letter-spacing: 0.9pt; text-transform: uppercase; color: #66645e; }
    .lead-option .tag { color: #ae5f46; }
    .option-name { padding-top: 3pt; font-size: 10.5pt; font-weight: bold; line-height: 1.2; }
    .premium { padding-top: 8pt; font-size: 21pt; font-weight: bold; line-height: 1.1; }
    .per { padding-bottom: 10pt; font-size: 8pt; color: #66645e; }
    .fact { padding: 6pt 0 6pt 0; border-top: 0.75pt solid #e8e6dc; }
    .lead-option .fact { border-top-color: #d9d6ca; }
    .fact .value { font-size: 10pt; }
    .text { padding: 6pt 0 7pt 0; border-top: 0.75pt solid #e8e6dc; font-size: 8pt; }
    .lead-option .text { border-top-color: #d9d6ca; }
    .reference { padding-top: 6pt; border-top: 0.75pt solid #e8e6dc; font-size: 7pt; color: #66645e; }
    .lead-option .reference { border-top-color: #d9d6ca; }

    /* What happens next. */
    .steps td { padding: 8pt 10pt 0 0; }
    .step-number { font-size: 13pt; font-weight: bold; color: #d97757; }
    .step-lead { font-size: 9pt; font-weight: bold; white-space: nowrap; }
    .step-line { font-size: 8pt; color: #66645e; white-space: nowrap; }

    /* What you told us. */
    .answers { margin-top: 12pt; page-break-inside: avoid; }
    .answers-title { padding: 5pt 8pt 5pt 8pt; background-color: #f0eee7; font-size: 8pt; font-weight: bold; white-space: nowrap; }
    .answers td { padding: 4pt 8pt 4pt 8pt; border-bottom: 0.75pt solid #e8e6dc; font-size: 8pt; white-space: nowrap; }
    .answers td.question { color: #66645e; }
    .answers td.answer { font-weight: bold; }
</style>
</head>
<body>
    <div class="footer">
        <table>
            <tr>
                <td style="width: 255pt;">Antsurance Insurance Company, a fictional insurer used for demonstrations</td>
                <td style="width: 150pt; text-align: center;"><apex:outputText value="{!documentLabel}"/></td>
                <td style="width: 120pt; text-align: right;">Page <span class="page-number"></span> of <span class="page-count"></span></td>
            </tr>
        </table>
    </div>

    <table class="band">
        <tr>
            <td style="width: 180pt;"><apex:image url="{!$Resource.antsuranceLockupOnWhite}" width="162" height="24" alt="Antsurance"/></td>
            <td style="width: 281pt; text-align: right;">
                <div class="band-title">INSURANCE PROPOSAL</div>
                <div class="band-line"><apex:outputText value="{!lineOfBusiness}"/></div>
            </td>
        </tr>
    </table>
    <table><tr><td class="rule">&#160;</td></tr></table>

    <apex:outputPanel layout="none" rendered="{!NOT(found)}">
        <div class="missing"><apex:outputText value="{!notice}"/></div>
        <div class="muted">Open the proposal from a policy sale that has at least one quote, and check that you have access to it.</div>
    </apex:outputPanel>

    <apex:outputPanel layout="none" rendered="{!found}">
        <table class="facts">
            <tr>
                <td style="width: 238pt;">
                    <div class="label">Prepared for</div>
                    <div class="value"><apex:outputText value="{!customerName}"/></div>
                    <apex:repeat value="{!addressLines}" var="line">
                        <div class="value-line"><apex:outputText value="{!line}"/></div>
                    </apex:repeat>
                </td>
                <td class="divide" style="width: 239pt;">
                    <div class="label">Prepared by</div>
                    <div class="value"><apex:outputText value="{!preparedBy}"/></div>
                    <div class="value-line">Antsurance Insurance Company</div>
                    <div class="value-line">1-800-555-0100</div>
                </td>
            </tr>
        </table>
        <table class="strip">
            <tr>
                <td style="width: 143pt;"><div class="label">Proposal date</div><div class="value"><apex:outputText value="{!proposalDate}"/></div></td>
                <td class="divide" style="width: 143pt;"><div class="label">Valid until</div><div class="value"><apex:outputText value="{!validUntil}"/></div></td>
                <td class="divide" style="width: 143pt;"><div class="label">Underwriter</div><div class="value"><apex:outputText value="{!underwriter}"/></div></td>
            </tr>
        </table>

        <div class="intro">
            <apex:repeat value="{!introLines}" var="line"><div><apex:outputText value="{!line}"/></div></apex:repeat>
        </div>

        <div class="section">
            <div class="section-title"><apex:outputText value="{!optionsHeading}"/></div>
            <table class="options">
                <tr class="top">
                    <apex:repeat value="{!options}" var="option">
                        <apex:repeat value="{!option.gaps}" var="gap"><td class="gap" style="width: {!gap};">&#160;</td></apex:repeat>
                        <td class="{!option.cellClass}" style="width: {!option.width};">
                            <div class="tag"><apex:outputText value="{!option.tag}"/></div>
                            <div class="option-name">
                                <apex:repeat value="{!option.nameLines}" var="line"><div><apex:outputText value="{!line}"/></div></apex:repeat>
                            </div>
                        </td>
                    </apex:repeat>
                </tr>
                <tr>
                    <apex:repeat value="{!options}" var="option">
                        <apex:repeat value="{!option.gaps}" var="gap"><td class="gap">&#160;</td></apex:repeat>
                        <td class="{!option.cellClass}">
                            <div class="premium"><apex:outputText value="{!option.premium}"/></div>
                            <div class="per"><apex:outputText value="{!option.monthly}"/></div>
                        </td>
                    </apex:repeat>
                </tr>
                <tr>
                    <apex:repeat value="{!options}" var="option">
                        <apex:repeat value="{!option.gaps}" var="gap"><td class="gap">&#160;</td></apex:repeat>
                        <td class="{!option.cellClass}">
                            <div class="fact"><div class="label">Coverage limit</div><div class="value"><apex:outputText value="{!option.limitText}"/></div></div>
                        </td>
                    </apex:repeat>
                </tr>
                <tr>
                    <apex:repeat value="{!options}" var="option">
                        <apex:repeat value="{!option.gaps}" var="gap"><td class="gap">&#160;</td></apex:repeat>
                        <td class="{!option.cellClass}">
                            <div class="fact"><div class="label">Deductible</div><div class="value"><apex:outputText value="{!option.deductible}"/></div></div>
                        </td>
                    </apex:repeat>
                </tr>
                <tr>
                    <apex:repeat value="{!options}" var="option">
                        <apex:repeat value="{!option.gaps}" var="gap"><td class="gap">&#160;</td></apex:repeat>
                        <td class="{!option.cellClass}">
                            <div class="text">
                                <div class="label">What it includes</div>
                                <apex:repeat value="{!option.includes}" var="line"><div><apex:outputText value="{!line}"/></div></apex:repeat>
                            </div>
                        </td>
                    </apex:repeat>
                </tr>
                <tr>
                    <apex:repeat value="{!options}" var="option">
                        <apex:repeat value="{!option.gaps}" var="gap"><td class="gap">&#160;</td></apex:repeat>
                        <td class="{!option.cellClass}">
                            <div class="text">
                                <div class="label">How it compares</div>
                                <apex:repeat value="{!option.differs}" var="line"><div><apex:outputText value="{!line}"/></div></apex:repeat>
                            </div>
                        </td>
                    </apex:repeat>
                </tr>
                <tr class="bottom">
                    <apex:repeat value="{!options}" var="option">
                        <apex:repeat value="{!option.gaps}" var="gap"><td class="gap">&#160;</td></apex:repeat>
                        <td class="{!option.cellClass}">
                            <div class="reference"><apex:outputText value="{!option.reference}"/></div>
                        </td>
                    </apex:repeat>
                </tr>
            </table>
        </div>

        <div class="{!stepsClass}">
            <div class="section-title">What happens next</div>
            <table class="steps">
                <tr>
                    <td style="width: 18pt;"><div class="step-number">1</div></td>
                    <td style="width: 137pt;">
                        <div class="step-lead"><apex:outputText value="{!firstStep}"/></div>
                        <apex:repeat value="{!firstStepLines}" var="line"><div class="step-line"><apex:outputText value="{!line}"/></div></apex:repeat>
                    </td>
                    <td style="width: 18pt;"><div class="step-number">2</div></td>
                    <td style="width: 137pt;">
                        <div class="step-lead"><apex:outputText value="{!acceptBy}"/></div>
                        <div class="step-line">Call 1-800-555-0100 or reply</div>
                        <div class="step-line"><apex:outputText value="{!replyTo}"/></div>
                    </td>
                    <td style="width: 18pt;"><div class="step-number">3</div></td>
                    <td style="width: 137pt;">
                        <div class="step-lead"><apex:outputText value="{!lastStep}"/></div>
                        <apex:repeat value="{!lastStepLines}" var="line"><div class="step-line"><apex:outputText value="{!line}"/></div></apex:repeat>
                    </td>
                </tr>
            </table>
        </div>

        <apex:outputPanel layout="none" rendered="{!hasAnswers}">
            <div class="{!answersClass}">
                <div class="section-title">What you told us</div>
                <div class="intro" style="margin-top: 8pt;">
                    <div><apex:outputText value="{!answersIntro}"/></div>
                </div>
            </div>
            <apex:repeat value="{!answerSections}" var="section">
                <div class="{!section.sectionClass}">
                    <div class="answers-title"><apex:outputText value="{!section.title}"/></div>
                    <apex:repeat value="{!section.rows}" var="row">
                        <!-- Each row is its own table: a pair of questions, or one long answer across the page. -->
                        <apex:outputPanel layout="none" rendered="{!row.isPair}">
                            <table>
                                <tr>
                                    <td class="question" style="width: 132pt;"><apex:outputText value="{!row.firstQuestion}"/></td>
                                    <td class="answer" style="width: 93pt;"><apex:outputText value="{!row.firstAnswer}"/></td>
                                    <td class="question" style="width: 132pt; padding-left: 20pt;"><apex:outputText value="{!row.secondQuestion}"/></td>
                                    <td class="answer" style="width: 92pt;"><apex:outputText value="{!row.secondAnswer}"/></td>
                                </tr>
                            </table>
                        </apex:outputPanel>
                        <apex:outputPanel layout="none" rendered="{!row.isWide}">
                            <table>
                                <tr>
                                    <td class="question" style="width: 132pt;"><apex:outputText value="{!row.firstQuestion}"/></td>
                                    <td class="answer" style="width: 361pt;"><apex:outputText value="{!row.firstAnswer}"/></td>
                                </tr>
                            </table>
                        </apex:outputPanel>
                    </apex:repeat>
                </div>
            </apex:repeat>
        </apex:outputPanel>

        <div class="{!closingClass}">
            <apex:repeat value="{!closingLines}" var="line"><div><apex:outputText value="{!line}"/></div></apex:repeat>
        </div>
    </apex:outputPanel>
    <apex:outputPanel layout="none" rendered="{!$CurrentPage.parameters.preview == '1'}">
    <!-- On-screen preview only: tells the Documents tab how tall the sheet is, so it can show all of it, and
         where the sheet can be cut for a first look without slicing a row: the bottom of each table row
         that no line of text crosses. Written without less-than signs and ampersands, which this page's markup would take for its own. -->
    <script type="text/javascript">
        (function () {
            function folds() {
                var all = document.body.getElementsByTagName('*');
                var rows = document.body.getElementsByTagName('tr');
                var lines = [];
                var cuts = [];
                var index, other, box, cut, crossed;
                for (index = 0; all.length > index; index++) {
                    if (all[index].children.length === 0) {
                        if (all[index].textContent.replace(/\s/g, '') !== '') {
                            box = all[index].getBoundingClientRect();
                            if (box.height > 0) {
                                lines.push([box.top + window.pageYOffset, box.bottom + window.pageYOffset]);
                            }
                        }
                    }
                }
                for (index = 0; rows.length > index; index++) {
                    cut = Math.ceil(rows[index].getBoundingClientRect().bottom + window.pageYOffset);
                    crossed = false;
                    for (other = 0; lines.length > other; other++) {
                        if (cut - 1 > lines[other][0]) {
                            if (lines[other][1] > cut + 1) {
                                crossed = true;
                            }
                        }
                    }
                    if (crossed === false) {
                        if (cuts.indexOf(cut) === -1) {
                            if (60 > cuts.length) {
                                cuts.push(cut);
                            }
                        }
                    }
                }
                return cuts;
            }
            function report() {
                window.parent.postMessage({ source: 'antsurance-document', token: '{!JSENCODE($CurrentPage.parameters.previewToken)}', height: document.body.offsetHeight, folds: folds() }, '*');
            }
            window.addEventListener('load', report);
            window.setTimeout(report, 400);
            window.setTimeout(report, 1500);
        })();
    </script>
    </apex:outputPanel>
</body>
</html>
</apex:page>
