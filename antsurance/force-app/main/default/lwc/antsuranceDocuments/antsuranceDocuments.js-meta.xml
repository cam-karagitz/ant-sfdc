<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <description>Lists the documents a policy, policy sale or customer can produce, previews the chosen one as a PDF, and opens, downloads or saves it to the record's files.</description>
    <isExposed>true</isExposed>
    <masterLabel>Antsurance Documents</masterLabel>
    <targets>
        <target>lightning__RecordPage</target>
        <target>lightning__UrlAddressable</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__RecordPage">
            <objects>
                <object>Policy__c</object>
                <object>Opportunity</object>
                <object>Account</object>
            </objects>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
