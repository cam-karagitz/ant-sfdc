<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Policy_Summary__c</fullName>
    <description>Policy number, line and insured item on one line, for pickers in flows.</description>
    <label>Policy Summary</label>
    <formula><![CDATA[Name & " " & TEXT(Line_of_Business__c) & IF(ISBLANK(Insured_Item__c), "", " (" & LEFT(Insured_Item__c, 60) & ")")]]></formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <required>false</required>
    <trackHistory>false</trackHistory>
    <unique>false</unique>
    <type>Text</type>
</CustomField>
