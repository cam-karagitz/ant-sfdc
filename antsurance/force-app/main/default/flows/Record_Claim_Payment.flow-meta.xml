<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <decisions>
        <name>Is_There_Reserve_to_Pay</name>
        <label>Is there reserve to pay from?</label>
        <locationX>176</locationX>
        <locationY>216</locationY>
        <defaultConnector>
            <targetReference>No_Reserve</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Has_Reserve</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Claim.Outstanding_Reserve__c</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Payment_Details</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <description>Records a payment against a claim reserve. It will not pay more than is outstanding, moves the claim to Payment Issued or closes it on a final payment, and logs the payment as a completed task.</description>
    <environments>Default</environments>
    <formulas>
        <name>ReserveText</name>
        <dataType>String</dataType>
        <expression>"$" &amp; IF(ROUND(BLANKVALUE({!Get_Claim.Reserve_Amount__c}, 0), 0) &gt;= 1000000, TEXT(FLOOR(ROUND(BLANKVALUE({!Get_Claim.Reserve_Amount__c}, 0), 0) / 1000000)) &amp; "," &amp; LPAD(TEXT(MOD(FLOOR(ROUND(BLANKVALUE({!Get_Claim.Reserve_Amount__c}, 0), 0) / 1000), 1000)), 3, "0") &amp; "," &amp; LPAD(TEXT(MOD(FLOOR(ROUND(BLANKVALUE({!Get_Claim.Reserve_Amount__c}, 0), 0)), 1000)), 3, "0"), IF(ROUND(BLANKVALUE({!Get_Claim.Reserve_Amount__c}, 0), 0) &gt;= 1000, TEXT(FLOOR(ROUND(BLANKVALUE({!Get_Claim.Reserve_Amount__c}, 0), 0) / 1000)) &amp; "," &amp; LPAD(TEXT(MOD(FLOOR(ROUND(BLANKVALUE({!Get_Claim.Reserve_Amount__c}, 0), 0)), 1000)), 3, "0"), TEXT(FLOOR(ROUND(BLANKVALUE({!Get_Claim.Reserve_Amount__c}, 0), 0)))))</expression>
    </formulas>
    <formulas>
        <name>PaidText</name>
        <dataType>String</dataType>
        <expression>"$" &amp; IF(ROUND(BLANKVALUE({!Get_Claim.Paid_Amount__c}, 0), 0) &gt;= 1000000, TEXT(FLOOR(ROUND(BLANKVALUE({!Get_Claim.Paid_Amount__c}, 0), 0) / 1000000)) &amp; "," &amp; LPAD(TEXT(MOD(FLOOR(ROUND(BLANKVALUE({!Get_Claim.Paid_Amount__c}, 0), 0) / 1000), 1000)), 3, "0") &amp; "," &amp; LPAD(TEXT(MOD(FLOOR(ROUND(BLANKVALUE({!Get_Claim.Paid_Amount__c}, 0), 0)), 1000)), 3, "0"), IF(ROUND(BLANKVALUE({!Get_Claim.Paid_Amount__c}, 0), 0) &gt;= 1000, TEXT(FLOOR(ROUND(BLANKVALUE({!Get_Claim.Paid_Amount__c}, 0), 0) / 1000)) &amp; "," &amp; LPAD(TEXT(MOD(FLOOR(ROUND(BLANKVALUE({!Get_Claim.Paid_Amount__c}, 0), 0)), 1000)), 3, "0"), TEXT(FLOOR(ROUND(BLANKVALUE({!Get_Claim.Paid_Amount__c}, 0), 0)))))</expression>
    </formulas>
    <formulas>
        <name>OutstandingText</name>
        <dataType>String</dataType>
        <expression>"$" &amp; IF(ROUND(BLANKVALUE({!Get_Claim.Outstanding_Reserve__c}, 0), 0) &gt;= 1000000, TEXT(FLOOR(ROUND(BLANKVALUE({!Get_Claim.Outstanding_Reserve__c}, 0), 0) / 1000000)) &amp; "," &amp; LPAD(TEXT(MOD(FLOOR(ROUND(BLANKVALUE({!Get_Claim.Outstanding_Reserve__c}, 0), 0) / 1000), 1000)), 3, "0") &amp; "," &amp; LPAD(TEXT(MOD(FLOOR(ROUND(BLANKVALUE({!Get_Claim.Outstanding_Reserve__c}, 0), 0)), 1000)), 3, "0"), IF(ROUND(BLANKVALUE({!Get_Claim.Outstanding_Reserve__c}, 0), 0) &gt;= 1000, TEXT(FLOOR(ROUND(BLANKVALUE({!Get_Claim.Outstanding_Reserve__c}, 0), 0) / 1000)) &amp; "," &amp; LPAD(TEXT(MOD(FLOOR(ROUND(BLANKVALUE({!Get_Claim.Outstanding_Reserve__c}, 0), 0)), 1000)), 3, "0"), TEXT(FLOOR(ROUND(BLANKVALUE({!Get_Claim.Outstanding_Reserve__c}, 0), 0)))))</expression>
    </formulas>
    <formulas>
        <name>PaymentText</name>
        <dataType>String</dataType>
        <expression>"$" &amp; IF(ROUND(BLANKVALUE({!Payment_Amount}, 0), 0) &gt;= 1000000, TEXT(FLOOR(ROUND(BLANKVALUE({!Payment_Amount}, 0), 0) / 1000000)) &amp; "," &amp; LPAD(TEXT(MOD(FLOOR(ROUND(BLANKVALUE({!Payment_Amount}, 0), 0) / 1000), 1000)), 3, "0") &amp; "," &amp; LPAD(TEXT(MOD(FLOOR(ROUND(BLANKVALUE({!Payment_Amount}, 0), 0)), 1000)), 3, "0"), IF(ROUND(BLANKVALUE({!Payment_Amount}, 0), 0) &gt;= 1000, TEXT(FLOOR(ROUND(BLANKVALUE({!Payment_Amount}, 0), 0) / 1000)) &amp; "," &amp; LPAD(TEXT(MOD(FLOOR(ROUND(BLANKVALUE({!Payment_Amount}, 0), 0)), 1000)), 3, "0"), TEXT(FLOOR(ROUND(BLANKVALUE({!Payment_Amount}, 0), 0)))))</expression>
    </formulas>
    <formulas>
        <name>NewPaid</name>
        <dataType>Currency</dataType>
        <expression>BLANKVALUE({!Get_Claim.Paid_Amount__c}, 0) + {!Payment_Amount}</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>NewReserve</name>
        <dataType>Currency</dataType>
        <expression>IF({!Final_Payment}, BLANKVALUE({!Get_Claim.Paid_Amount__c}, 0) + {!Payment_Amount}, {!Get_Claim.Reserve_Amount__c})</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>NewStatus</name>
        <dataType>String</dataType>
        <expression>IF({!Final_Payment}, "Closed", "Payment Issued")</expression>
    </formulas>
    <formulas>
        <name>PaymentTaskSubject</name>
        <dataType>String</dataType>
        <expression>"Payment of " &amp; {!PaymentText} &amp; " issued to " &amp; {!Payee}</expression>
    </formulas>
    <formulas>
        <name>DefaultPayee</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!Get_Claim.ContactId}), "", {!Get_Claim.Contact.FirstName} &amp; " " &amp; {!Get_Claim.Contact.LastName})</expression>
    </formulas>
    <interviewLabel>Record a Claim Payment {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Record a Claim Payment</label>
