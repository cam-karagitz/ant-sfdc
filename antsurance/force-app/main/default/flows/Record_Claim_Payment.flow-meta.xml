            <value>
                <elementReference>NewStatus</elementReference>
            </value>
        </inputAssignments>
        <object>Case</object>
    </recordUpdates>
    <screens>
        <name>No_Reserve</name>
        <label>No reserve</label>
        <locationX>176</locationX>
        <locationY>324</locationY>
        <allowBack>true</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>No_Reserve_Message</name>
            <fieldText>&lt;p&gt;&lt;strong&gt;There is no outstanding reserve on this claim.&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;Set or raise the reserve before recording a payment.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Payment_Details</name>
        <label>Payment details</label>
        <locationX>176</locationX>
        <locationY>432</locationY>
        <allowBack>true</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>Update_Claim</targetReference>
        </connector>
        <fields>
            <name>Claim_Position</name>
            <fieldText>&lt;p&gt;&lt;strong&gt;{!Get_Claim.CaseNumber}: {!Get_Claim.Subject}&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;Reserved {!ReserveText}. Paid so far {!PaidText}. Outstanding {!OutstandingText}.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <fields>
            <name>Payment_Amount</name>
            <dataType>Currency</dataType>
            <fieldText>Payment amount, up to {!OutstandingText}</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>true</isRequired>
            <scale>2</scale>
            <validationRule>
                <errorMessage>&lt;p&gt;Enter an amount above zero and no more than the outstanding reserve.&lt;/p&gt;</errorMessage>
                <formulaExpression>{!Payment_Amount} &gt; 0 &amp;&amp; {!Payment_Amount} &lt;= {!Get_Claim.Outstanding_Reserve__c}</formulaExpression>
            </validationRule>
        </fields>
        <fields>
            <name>Payee</name>
            <dataType>String</dataType>
            <defaultValue>
                <elementReference>DefaultPayee</elementReference>
            </defaultValue>
            <fieldText>Pay to</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>true</isRequired>
        </fields>
        <fields>
            <name>Final_Payment</name>
            <dataType>Boolean</dataType>
            <fieldText>This is the final payment. Close the claim and release any reserve left.</fieldText>
            <fieldType>InputField</fieldType>
        </fields>
        <nextOrFinishButtonLabel>Record Payment</nextOrFinishButtonLabel>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Payment_Recorded</name>
        <label>Payment recorded</label>
        <locationX>176</locationX>
        <locationY>756</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>Recorded_Message</name>
            <fieldText>&lt;p&gt;&lt;strong&gt;{!PaymentText} recorded, payable to {!Payee}.&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;The claim is now {!NewStatus}.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Could_Not_Save</name>
        <label>Could not save</label>
        <locationX>176</locationX>
