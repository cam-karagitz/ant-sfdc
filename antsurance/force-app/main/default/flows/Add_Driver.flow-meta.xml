    <decisions>
        <name>Is_This_an_Auto_Policy</name>
        <label>Is this an auto policy?</label>
        <locationX>176</locationX>
        <locationY>216</locationY>
        <defaultConnector>
            <targetReference>Not_an_Auto_Policy</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Auto</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>Get_Policy.Line_of_Business__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Personal Auto</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Policy.Line_of_Business__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Commercial Auto</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Current_Drivers</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <name>Already_a_Driver</name>
        <label>Already a driver on this policy?</label>
        <locationX>176</locationX>
        <locationY>1188</locationY>
        <defaultConnector>
            <targetReference>Create_Participant</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Listed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Find_Existing_Driver</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Already_Listed</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <description>Adds a household member to an auto policy as a rated driver: captures the license and three-year driving record, works out the rating tier, and creates a task to re-rate the policy.</description>
    <dynamicChoiceSets>
        <name>HouseholdMembers</name>
        <dataType>String</dataType>
        <displayField>Name</displayField>
        <filterLogic>and</filterLogic>
        <filters>
            <field>AccountId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Policy.Account__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>Id</field>
            <operator>NotIn</operator>
            <value>
                <elementReference>existingDriverIds</elementReference>
            </value>
        </filters>
        <object>Contact</object>
        <sortField>Name</sortField>
        <sortOrder>Asc</sortOrder>
        <valueField>Id</valueField>
    </dynamicChoiceSets>
    <dynamicChoiceSets>
        <name>PolicyVehicles</name>
        <dataType>String</dataType>
        <displayField>Name</displayField>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Policy__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <filters>
            <field>Asset_Type__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Vehicle</stringValue>
            </value>
        </filters>
        <object>Policy_Asset__c</object>
        <sortField>Name</sortField>
        <sortOrder>Asc</sortOrder>
        <valueField>Name</valueField>
    </dynamicChoiceSets>
    <dynamicChoiceSets>
        <name>Relationships</name>
